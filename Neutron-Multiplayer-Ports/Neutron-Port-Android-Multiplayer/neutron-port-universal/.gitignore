# Desktop Makefile build -- .o files land directly next to the source
# (see Makefile's %.o: %.cpp rule), not in a separate build/ directory
*.o

# Desktop CMake build
/build/

# Android native (CMake+NDK) build
/build-android/

# Packaged output (apk + standalone .so, regenerated by the rebuild steps in README.txt)
/android-build/

# Vendored desktop runtime libs (regenerate via your distro's package manager;
# not original project source -- see README.txt)
/libs/

# Gradle build artifacts and machine-specific config
/android/.gradle/
/android/app/build/
/android/local.properties

# Compiled native library -- rebuilt from src/+include/ by the native build
# step (README.txt section 8), not committed source
/android/app/src/main/jniLibs/

# Runtime output, not source
/neutron_save.txt

# Editor/OS cruft
.DS_Store
*.swp
