#############################################
# Order-only phony target for SDL2_mixer

build cmake_object_order_depends_target_SDL2_mixer: phony || cmake_object_order_depends_target_SDL2-static

build _deps/sdl2_mixer-build/CMakeFiles/SDL2_mixer.dir/src/codecs/load_aiff.c.o: C_COMPILER__SDL2_mixer_unscanned_Release /workspace/neutron-port-android-universal/build-android-arm64/_deps/sdl2_mixer-src/src/codecs/load_aiff.c || cmake_object_order_depends_target_SDL2_mixer
  DEFINES = -DBUILD_SDL -DHAVE_FORK -DMUSIC_CMD -DMUSIC_WAV -DSDL_BUILD_MAJOR_VERSION=2 -DSDL_BUILD_MICRO_VERSION=0 -DSDL_BUILD_MINOR_VERSION=8
  DEP_FILE = _deps/sdl2_mixer-build/CMakeFiles/SDL2_mixer.dir/src/codecs/load_aiff.c.o.d
  FLAGS = -g -DANDROID -fdata-sections -ffunction-sections -funwind-tables -fstack-protector-strong -no-canonical-prefixes -D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security  -O3 -DNDEBUG  -fPIC -fvisibility=hidden
  INCLUDES = -I/workspace/neutron-port-android-universal/build-android-arm64/_deps/sdl2_mixer-src/include -I/workspace/neutron-port-android-universal/build-android-arm64/_deps/sdl2_mixer-src/src -I/workspace/neutron-port-android-universal/build-android-arm64/_deps/sdl2_mixer-src/src/codecs -I/workspace/neutron-port-android-universal/build-android-arm64/_deps/sdl2-build/include -I/workspace/neutron-port-android-universal/build-android-arm64/_deps/sdl2-build/include/SDL2 -I/workspace/neutron-port-android-universal/build-android-arm64/_deps/sdl2-build/include-config-release/SDL2
  OBJECT_DIR = _deps/sdl2_mixer-build/CMakeFiles/SDL2_mixer.dir
